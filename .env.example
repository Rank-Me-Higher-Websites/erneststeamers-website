# Local wrangler secrets. Copy the variable into .dev.vars for
# `wrangler pages dev`. Do not commit .dev.vars or a real webhook URL.

# Pages Function functions/api/leads.js POSTs quote leads here.
# Set the same name as a Cloudflare Pages secret. If it is unset,
# /api/leads returns 502 and does not call n8n.
# Do not use a VITE_ prefix — this URL must not be bundled into the client.
N8N_LEAD_WEBHOOK=
