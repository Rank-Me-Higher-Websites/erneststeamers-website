# Copy to .env for local runs. Do not commit .env or put real secrets in this file.

# Postgres connection string used by serve.js for POST /api/leads.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Server-side n8n webhook. After a lead is saved, serve.js POSTs the
# quote payload to this URL. Leave unset to skip the forward; the lead
# is still stored and the API still returns success.
# The Pages Function uses this same variable name (N8N_LEAD_WEBHOOK).
# Do not use a VITE_ prefix — this URL must not be bundled into the client.
N8N_LEAD_WEBHOOK=
